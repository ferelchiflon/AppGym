{
  "name": "gym-pro",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "description": "Registro de entrenamiento, periodización y seguimiento de progreso.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests scripts eslint.config.js vite.config.js vitest.config.js --ext .js,.ts,.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,css}\"",
    "test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest run",
    "test:watch": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest",
    "test:coverage": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest run --coverage",
    "scripts:icons": "node scripts/generate-pwa-icons.mjs",
    "scripts:extract-views": "node scripts/extract-views.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "terser": "^5.50.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
